<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmation Page</title>
</head>
<body>
    <h1>Thank you for your order, <%= order.name %>!</h1>
    
    <h2> Order Summary </h2>
    <p>Order Date and Time: <%= order.timestamp.toLocaleString() %></p>
    <p>Name: <%= order.name %></p>
    <p>Email: <%= order.email %></p>
    <p>Flavor: <%= order.flavor %></p>
    <p>Toppings: <%= order.toppings %> </p>
    <p>Comments: <%= order.comment %> </p>
    <a href="/">Want to make another order</a>
    <a href="/admin">Admin Page</a>
</body>
</html>